# Skool Downloader Environment Configuration

# Katalog główny dla pobranych danych / kopii zapasowych
SKOOL_ARCHIVE_ROOT=$HOME/Downloads/Skool-Backup

# Nazwa kolekcji / folderu nadrzędnego
SKOOL_COLLECTION_NAME=Skool Community

# Pełny URL do kursu / classroom (np. https://www.skool.com/community-name/classroom)
SKOOL_CLASSROOM_URL=

# Pełny URL do społeczności / feedu (np. https://www.skool.com/community-name)
SKOOL_COMMUNITY_URL=

# Jakość pobieranego/konwertowanego wideo (opcje: 720p, 1080p, best)
VIDEO_QUALITY=720p

# Ścieżka do yt-dlp
YTDLP=/opt/homebrew/bin/yt-dlp

# Pobieranie tylko tekstu (1 = tak, 0 = pobieraj media/załączniki)
SKOOL_TEXT_ONLY=0

# Maksymalny rozmiar pobieranego załącznika w MB
MAX_ATTACHMENT_MB=30
