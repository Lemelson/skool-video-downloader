# Skool Downloader configuration.
# Copy to .env and fill in what you need. Values already set in your shell take priority.
# Leave a value empty (or comment it out) to use the default.

# Root folder for downloads/backups (default: current directory). ~ and $HOME are expanded.
SKOOL_ARCHIVE_ROOT=~/Downloads/Skool-Backup

# Sub-folder under the root for this community (default: Skool Community)
SKOOL_COLLECTION_NAME=Skool Community

# Course / classroom URL, e.g. https://www.skool.com/community-name/classroom
SKOOL_CLASSROOM_URL=

# Community feed URL, e.g. https://www.skool.com/community-name
SKOOL_COMMUNITY_URL=

# Video quality: 720p, 1080p (default) or best
VIDEO_QUALITY=1080p

# Browser CDP endpoint (default: http://127.0.0.1:9222)
# SKOOL_CDP_URL=http://127.0.0.1:9222

# Path to yt-dlp (default: yt-dlp on PATH)
# YTDLP=/opt/homebrew/bin/yt-dlp

# Community archive: text only (1) or also download media/attachments (0)
SKOOL_TEXT_ONLY=0

# Community archive: max attachment size in MB
MAX_ATTACHMENT_MB=30
