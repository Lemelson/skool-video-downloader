{
  "name": "skool-video-downloader",
  "version": "1.0.0",
  "description": "Command-line toolkit to download and back up your own Skool videos, lessons, and community posts for offline access, using the Chrome DevTools Protocol, Playwright, yt-dlp and ffmpeg.",
  "keywords": [
    "skool",
    "skool-downloader",
    "skool-video-downloader",
    "download-skool-videos",
    "skool-course-downloader",
    "course-backup",
    "archive",
    "offline",
    "playwright",
    "yt-dlp",
    "cdp"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "playwright": "^1.44.0"
  },
  "scripts": {
    "launch:brave": "bash ./scripts/launch_brave_cdp.sh",
    "inspect": "node -r dotenv/config scripts/cdp_inspect.js",
    "course:state": "node -r dotenv/config scripts/cdp_course_state.js",
    "download:details": "node -r dotenv/config scripts/cdp_download_lesson_details.js",
    "download:pdf": "node -r dotenv/config scripts/cdp_download_pdf_resources.js",
    "download:videos": "python3 scripts/download_accessible_videos.py",
    "download:all": "node scripts/download_all.js",
    "download:everything": "node scripts/download_everything.js",
    "archive:community": "node -r dotenv/config scripts/cdp_archive_skool_community.js",
    "archive:post": "node -r dotenv/config scripts/cdp_archive_skool_post.js",
    "optimize:videos": "python3 scripts/optimize_videos_1080p.py"
  }
}
